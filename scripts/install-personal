#!/bin/bash
# Personal distribution installer.
#
# This repo is a private fork of KiwiDesk. This script makes a
# machine match it exactly: it builds the app from this checkout,
# installs it to /Applications with Sparkle's updater keys STRIPPED
# (a local build must never auto-update itself over the release
# channel), and syncs the configuration from personal/ into
# ~/.config/KiwiDesk — backing up whatever it replaces.
#
# Usage:
#   scripts/install-personal                 # app + configs
#   scripts/install-personal --config-only   # configs only
#   scripts/install-personal --app-only      # build + app only
#
# Signing: prefer a "Developer ID Application" identity; fall
# back to any other codesigning identity in the keychain, then
# ad-hoc. Any stable certificate keeps the Accessibility grant
# across rebuilds; only ad-hoc loses it. Local (non-Apple)
# certificates get no Team ID, so the re-seal disables library
# validation — without it macOS refuses to load the embedded
# Sparkle framework at launch.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_DIR="$HOME/.config/KiwiDesk"
APP="/Applications/KiwiDesk.app"
MODE="all"
case "${1:-}" in
    "") ;;
    --config-only) MODE="config" ;;
    --app-only) MODE="app" ;;
    *) echo "error: unknown argument '$1'" >&2; exit 2 ;;
esac

install_configs() {
    if [ ! -f "$ROOT/personal/gui.json" ]; then
        echo "error: personal/ is missing from this checkout" >&2
        exit 1
    fi
    mkdir -p "$CONFIG_DIR/profiles"
    local backup
    backup="$CONFIG_DIR/personal-backup-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$backup/profiles"
    for name in gui.json init.lua; do
        if [ -f "$CONFIG_DIR/$name" ]; then
            cp "$CONFIG_DIR/$name" "$backup/$name"
        fi
        cp "$ROOT/personal/$name" "$CONFIG_DIR/$name"
    done
    for path in "$ROOT"/personal/profiles/*.json; do
        local name
        name="$(basename "$path")"
        if [ -f "$CONFIG_DIR/profiles/$name" ]; then
            cp "$CONFIG_DIR/profiles/$name" "$backup/profiles/$name"
        fi
        cp "$path" "$CONFIG_DIR/profiles/$name"
    done
    echo "==> configs installed (backup: $backup)"
}

install_app() {
    # actool (the app icon) ships with Xcode, not with Command
    # Line Tools; use a full Xcode when one is installed.
    if ! xcrun -f actool >/dev/null 2>&1 \
        && [ -d /Applications/Xcode.app ]; then
        export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
    fi
    local icon_flag=""
    xcrun -f actool >/dev/null 2>&1 || icon_flag="--allow-no-icon"

    local identity
    identity="$(security find-identity -v -p codesigning 2>/dev/null \
        | sed -n 's/.*"\(Developer ID Application: [^"]*\)".*/\1/p' \
        | head -1)"
    if [ -z "$identity" ]; then
        identity="$(security find-identity -v -p codesigning 2>/dev/null \
            | sed -n 's/^[[:space:]]*[0-9]*) [0-9A-F]* "\([^"]*\)"$/\1/p' \
            | head -1)"
    fi
    if [ -z "$identity" ]; then
        echo "warning: no codesigning identity; ad-hoc signing means" \
             "an Accessibility re-grant after install" >&2
        identity="-"
    fi
    bash "$ROOT/scripts/build-app.sh" --identity "$identity" $icon_flag

    # Local-build policy: no update channel, then re-seal.
    for key in SUFeedURL SUEnableAutomaticChecks SUPublicEDKey; do
        /usr/libexec/PlistBuddy -c "Delete :$key" \
            "$ROOT/.build/app/KiwiDesk.app/Contents/Info.plist" \
            >/dev/null 2>&1 || true
    done
    local seal=(--force --options runtime)
    case "$identity" in
        "Developer ID Application:"*) ;;
        *)
            # The key must parse EXACTLY; a stray newline inside
            # <key> silently voids the entitlement and the app
            # dies at launch on library validation.
            cat > "$ROOT/.build/local-entitlements.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
PLIST
            plutil -lint "$ROOT/.build/local-entitlements.plist" \
                >/dev/null
            /usr/libexec/PlistBuddy -c \
                "Print :com.apple.security.cs.disable-library-validation" \
                "$ROOT/.build/local-entitlements.plist" >/dev/null
            seal+=(--entitlements "$ROOT/.build/local-entitlements.plist")
            ;;
    esac
    codesign "${seal[@]}" --sign "$identity" \
        "$ROOT/.build/app/KiwiDesk.app" >/dev/null
    codesign --verify --deep --strict "$ROOT/.build/app/KiwiDesk.app"

    osascript -e 'tell application id "com.kiwicanopy.kiwidesk" to quit' \
        >/dev/null 2>&1 || true
    for _ in $(seq 1 20); do
        pgrep -f "KiwiDesk.app/Contents/MacOS/KiwiDesk" >/dev/null || break
        sleep 0.5
    done
    rm -rf "$APP"
    ditto "$ROOT/.build/app/KiwiDesk.app" "$APP"
    open -a "$APP"
    echo "==> app installed and launched"
}

if [ "$MODE" != "app" ]; then install_configs; fi
if [ "$MODE" != "config" ]; then install_app; fi

# Wait for the app to answer, then make the install true: reload
# the synced config and, where the active profile is not ours (a
# new machine's display fingerprint never matched its saved
# monitor set), adopt it explicitly so its settings apply —
# Scrolling everywhere, borders off, the menu-bar readout.
CLI="$APP/Contents/MacOS/KiwiDesk"
if [ -x "$CLI" ]; then
    for _ in $(seq 1 15); do
        [ -S "$CONFIG_DIR/KiwiDesk.sock" ] && break
        sleep 1
    done
    if [ -S "$CONFIG_DIR/KiwiDesk.sock" ]; then
        "$CLI" reload_config >/dev/null || true
        status="$("$CLI" get_profile_status 2>/dev/null || true)"
        name="$(printf '%s' "$status" \
            | sed -n 's/.*"name" *: *"\([^"]*\)".*/\1/p')"
        if [ -n "$name" ] \
            && [ "$name" != "My Setup - laptop" ]; then
            "$CLI" load_profile "My Setup - laptop" >/dev/null \
                || true
        fi
        echo "==> profile: $("$CLI" get_profile_status \
            2>/dev/null || echo unknown)"
    fi
fi
echo "Done. Details: personal/README.md"
